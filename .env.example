# Neon Postgres connection string. Use the pooled connection string from the
# Neon dashboard (Connection Details -> Pooled connection).
# The app connects via the Neon serverless driver adapter (WebSocket), not
# node-postgres, so this is the only connection string needed.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/leadradar?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend, from https://resend.com/api-keys — used for magic-link sign-in
# emails now, and scheduled export emails later.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Lead Radar <onboarding@resend.dev>"

# Local dev only: run `npx inngest-cli@latest dev -u http://localhost:3000/api/inngest`
# alongside `npm run dev`, with this set to 1. In production, remove this and
# set INNGEST_SIGNING_KEY / INNGEST_EVENT_KEY instead (from the Inngest
# dashboard, after connecting your deployed app).
INNGEST_DEV=1

# Optional, temporary: set to "1" to bypass Auth.js entirely while you sort
# out Google/Resend accounts. Every request acts as one shared auto-created
# dev org — no login screen, no credentials needed. Unset (or anything
# other than "1") to restore real auth. NEVER set this in production —
# src/auth.ts logs a warning on startup if it's on, and the app shows a red
# banner on every page as a reminder.
# AUTH_DISABLED=1
