// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  plan                String   @default("free")
  tokenBudgetMonthly  Int      @default(200000)
  tokensUsedThisMonth Int      @default(0)
  budgetResetAt       DateTime @default(now())
  stripeCustomerId    String?  @unique
  createdAt           DateTime @default(now())

  users       User[]
  memberships Membership[]
  profiles    Profile[]
  sources     Source[]
  articles    Article[]
  runs        Run[]

  @@map("organizations")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// Every user currently belongs to exactly one org via User.organizationId.
// This table exists so multi-org membership is a data migration later, not a
// schema migration. Not enforced anywhere yet.
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  memberships  Membership[]

  @@index([organizationId])
  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Application data
// ---------------------------------------------------------------------------

// What to look for and who to hand it to. A run's keyword filter, scoring,
// and contact-role matching all read from one of these.
model Profile {
  id             String @id @default(cuid())
  organizationId String

  name         String
  productsSold String

  industriesTargeted String[]
  buyerRoles         String[]
  regions            String[]
  signalKeywords     String[]
  excludeKeywords    String[]

  // Defaults mirror PROJECT_BRIEF.md.txt's scoring weights (out of 100):
  // signal strength 30, geographic fit 25, industry fit 20, recency 15,
  // contact availability 10. Tunable per profile; stored as JSON since the
  // component list may grow without a schema migration.
  scoringWeights Json @default("{\"signalStrength\":30,\"geographicFit\":25,\"industryFit\":20,\"recency\":15,\"contactAvailability\":10}")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources      Source[]
  runs         Run[]

  @@index([organizationId])
  @@map("profiles")
}

enum SourceType {
  RSS
  HTML
}

enum SourceStatus {
  ACTIVE
  SUGGESTED
  REJECTED
}

// A news source to crawl. type/feedUrl/selectors come from the add-by-URL
// detection flow (src/lib/sources/detect.ts) — RSS when a feed is found,
// HTML with a CSS-selector recipe otherwise. status SUGGESTED is unused
// until the source-suggestion feature (BUILD_ORDER.md.txt step 12); every
// source added manually here starts ACTIVE.
model Source {
  id             String @id @default(cuid())
  organizationId String
  profileId      String

  name String
  url  String

  type    SourceType
  feedUrl String?
  // For HTML sources: { articleSelector, titleSelector, linkSelector }.
  // Null for RSS sources.
  selectors Json?

  status          SourceStatus @default(ACTIVE)
  suggestedReason String?

  lastCrawledAt DateTime?
  lastSuccessAt DateTime?
  errorCount    Int       @default(0)
  articlesFound Int       @default(0)
  leadsFound    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  articles     Article[]

  @@unique([organizationId, url])
  @@index([organizationId])
  @@index([profileId])
  @@map("sources")
}

enum ArticleStage {
  FETCHED
  KEYWORD_REJECTED
  KEYWORD_PASSED
  CLASSIFIED
  LEAD_EXTRACTED
}

// One crawled article. Dedupe key is [organizationId, urlHash] (a hash of
// the *normalized* URL — see src/lib/pipeline/fetch.ts), not urlHash alone,
// per the multi-tenant rule: two orgs crawling the same public article must
// not collide. CLASSIFIED/LEAD_EXTRACTED stages are unused until step 7;
// step 6 only ever produces FETCHED -> KEYWORD_REJECTED|KEYWORD_PASSED.
model Article {
  id             String @id @default(cuid())
  organizationId String
  sourceId       String

  url     String
  urlHash String

  title       String
  publishedAt DateTime?
  bodyText    String?

  stage         ArticleStage @default(FETCHED)
  keywordScore  Int          @default(0)
  rejectReason  String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, urlHash])
  @@index([organizationId])
  @@index([sourceId])
  @@map("articles")
}

enum RunMode {
  BACKFILL
  SCHEDULED
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// One pipeline invocation. Funnel counters (articlesFetched -> ...Filtered
// -> ...Classified -> leadsCreated) make drop-off visible at every stage,
// per BUILD_ORDER.md.txt step 6. tokensIn/tokensOut/estimatedCost stay 0
// until step 7 adds LLM calls — present now so the schema doesn't need to
// change under a running feature.
model Run {
  id             String @id @default(cuid())
  organizationId String
  profileId      String

  mode   RunMode
  status RunStatus @default(RUNNING)

  lookbackDays Int?

  articlesFetched    Int @default(0)
  articlesFiltered   Int @default(0)
  articlesClassified Int @default(0)
  leadsCreated       Int @default(0)

  tokensIn       Int @default(0)
  tokensOut      Int @default(0)
  estimatedCost  Float @default(0)

  errors Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([profileId])
  @@map("runs")
}
